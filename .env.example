# Copy to .env and fill in. Leave DATABASE_URL empty for search-only (no accounts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# disable | require | verify-full  (verify-full checks the server cert against DB_SSL_ROOT_CERT)
DB_SSL=require
DB_SSL_ROOT_CERT=/certs/shared-postgres-ca.crt

# AES-256-GCM key for personal data, and a separate HMAC key for lookups / code hashes.
# Losing DATA_KEY makes encrypted user data unreadable. Never change them once in use.
DATA_KEY=
INDEX_KEY=

# Public HTTPS address (WebAuthn relying party + OAuth redirect URLs + secure cookies).
PUBLIC_URL=https://search.example.com
# Only serve on the public HTTPS address; plain LAN http:// requests redirect there.
REQUIRE_HTTPS=false
# Optional: true = must sign in before searching. false = accounts are optional (settings sync).
REQUIRE_LOGIN=false
# Optional: false = no new sign-ups (existing users can still sign in).
ALLOW_REGISTRATION=true

# Optional sign-in providers. A button appears only when both values are set.
# Redirect URL to register with each provider: <PUBLIC_URL>/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
